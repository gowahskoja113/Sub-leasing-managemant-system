@startuml CompleteCheckoutRequest
title Figure — CompleteCheckoutRequest (Terminate Contract at Move-out) Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor Manager
participant "Front-end" as FE
participant "CheckoutRequestController" as C
participant "TenantCheckoutServiceImpl" as S
participant "CheckoutRequestRepository" as CRR
participant "CheckoutSettlementRepository" as CSR
participant "TenantInvoiceRepository" as TIR
participant "TenantOnboardingServiceImpl" as TOS
participant "NotificationRepository" as NR
database DB

Manager -> FE : (1) Enter actual move-out date and note\nClick "Complete / terminate contract"
FE -> C : (2) POST /api/v1/checkout-requests/{id}/complete\nCompleteCheckoutRequest
activate C
C -> S : (3) completeRequest(requestId, managerUserId, request)
activate S

S -> DB : (4) BeginTransaction()
activate DB
DB --> S : (5) Success

S -> CRR : (6) findById(requestId)
activate CRR
CRR -> DB : (7) SELECT CheckoutRequest
DB --> CRR : (8) CheckoutRequest
CRR --> S : (9) CheckoutRequest
deactivate CRR

alt Status not APPROVED / SETTLING OR contract not ACTIVE / EXPIRED OR\nactual move-out before contract start
  S --> C : BusinessException
  C --> FE : Error response
  FE --> Manager : Show error
end

S -> CSR : (10) assertChargesSettledBeforeComplete():\nfind settlement invoices
activate CSR
CSR -> DB : (11) SELECT CheckoutSettlement + invoices
DB --> CSR : (12) settlement
CSR --> S : (13) settlement
deactivate CSR
S -> TIR : (14) findByTenantContractIdAndStatusNotIn(PAID, CANCELLED)
activate TIR
TIR -> DB : (15) SELECT TenantInvoice
DB --> TIR : (16) unpaid invoices
TIR --> S : (17) List<TenantInvoice>
deactivate TIR

alt Tenant still owes settlement charges
  S --> C : BusinessException
  C --> FE : Error response
  FE --> Manager : Show error
end

S -> TOS : (18) terminateActiveContract(contractId,\nTerminateContractRequest type = EARLY_MOVE_OUT)
activate TOS
TOS -> DB : (19) UPDATE Room -> AVAILABLE, restore equipment,\nUPDATE TenantContract status = TERMINATED,\nrevert listed price
DB --> TOS : (20) OK
TOS --> S : (21) TenantContractResponse
deactivate TOS

S -> CRR : (22) save(status = COMPLETED, completedAt, reviewedBy)
activate CRR
CRR -> DB : (23) UPDATE CheckoutRequest
DB --> CRR : (24) OK
deactivate CRR

S -> NR : (25) sendNotification(tenant, CHECKOUT_COMPLETED)
activate NR
NR -> DB : (26) INSERT Notification
DB --> NR : (27) OK
deactivate NR

break Business / system error
  S -> DB : RollbackTransaction()
  DB --> S : Rolled back
  S --> C : Exception
  C --> FE : Error response
  FE --> Manager : Show error
end

S -> DB : (28) CommitTransaction()
DB --> S : (29) Committed
deactivate DB

S --> C : (30) CheckoutRequestResponse
deactivate S
C --> FE : (31) 200 OK
deactivate C
FE --> Manager : (32) Show COMPLETED, room available again

@enduml
