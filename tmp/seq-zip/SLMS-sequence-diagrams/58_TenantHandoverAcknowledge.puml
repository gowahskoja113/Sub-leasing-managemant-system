@startuml TenantHandoverAcknowledge
title Figure — TenantHandoverAcknowledge (View & Acknowledge Handover Record) Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor Tenant
participant "Front-end" as FE
participant "TenantMeLifecycleController" as C
participant "TenantHandoverServiceImpl" as S
participant "TenantContractRepository" as TCR
participant "ContractEquipmentServiceImpl" as CES
database DB

== View the handover record ==
Tenant -> FE : (1) Open "Handover record"
FE -> C : (2) GET /api/v1/tenant/me/handover?contractId=
activate C
C -> S : (3) getHandover(tenantUserId, contractId)
activate S
S -> TCR : (4) findByTenantId(tenantUserId)
activate TCR
TCR -> DB : (5) SELECT TenantContract
DB --> TCR : (6) contracts
TCR --> S : (7) List<TenantContract>
deactivate TCR

S -> S : (8) listReadable(): ACTIVE / readable statuses,\npick contract by contractId or the only ACTIVE one

alt No readable contract / contract not owned /\nmany contracts and no contractId
  S --> C : ResourceNotFoundException / BusinessException
  C --> FE : Error response
  FE --> Tenant : Show error
end

S -> CES : (9) mapSelectedToItems(contract)
activate CES
CES -> DB : (10) SELECT selected TenantContractEquipment
DB --> CES : (11) equipment items
CES --> S : (12) List<EquipmentItem>
deactivate CES

S --> C : (13) TenantHandoverResponse\n(initial meter readings + photos, room condition photos / note,\nequipment list, acknowledged flag)
deactivate S
C --> FE : (14) 200 OK
deactivate C
FE --> Tenant : (15) Show handover record

== Acknowledge the record ==
Tenant -> FE : (16) Click "I acknowledge the handover record"
FE -> C : (17) POST /api/v1/tenant/me/handover/acknowledge
activate C
C -> S : (18) acknowledgeHandover(tenantUserId, contractId)
activate S

S -> DB : (19) BeginTransaction()
activate DB
DB --> S : (20) Success

S -> TCR : (21) resolveActiveContract(tenantUserId, contractId)
activate TCR
TCR -> DB : (22) SELECT TenantContract
DB --> TCR : (23) TenantContract
TCR --> S : (24) ACTIVE TenantContract
deactivate TCR

alt Already acknowledged
  S --> C : BusinessException
  C --> FE : Error response
  FE --> Tenant : Show error
end

S -> TCR : (25) save(handoverAcknowledgedAt = now)
activate TCR
TCR -> DB : (26) UPDATE TenantContract
DB --> TCR : (27) OK
deactivate TCR

break Business / system error
  S -> DB : RollbackTransaction()
  DB --> S : Rolled back
  S --> C : Exception
  C --> FE : Error response
  FE --> Tenant : Show error
end

S -> DB : (28) CommitTransaction()
DB --> S : (29) Committed
deactivate DB
S --> C : (30) TenantHandoverResponse (acknowledged = true)
deactivate S
C --> FE : (31) 200 OK
deactivate C
FE --> Tenant : (32) Show "Acknowledged"

@enduml
