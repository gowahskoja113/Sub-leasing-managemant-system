@startuml TenantActivationConfirm
title Figure — TenantActivation (Confirm OTP & Set Password) Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor Tenant
participant "Front-end" as FE
participant "AuthController" as C
participant "TenantActivationServiceImpl" as S
participant "OtpServiceImpl" as OTP
participant "OtpVerificationRepository" as OVR
participant "UserRepository" as UR
participant "PasswordEncoder" as PE
participant "CustomUserDetailsService" as UDS
participant "JwtUtil" as JWT
database DB

Tenant -> FE : (1) Enter OTP + new password + confirm password\nClick "Confirm"
FE -> C : (2) POST /api/v1/auth/tenant-activate/confirm\nTenantActivateConfirmRequest
activate C
C -> S : (3) confirm(request)
activate S

S -> DB : (4) BeginTransaction()
activate DB
DB --> S : (5) Success

alt newPassword != confirmPassword
  S --> C : BusinessException
  C --> FE : Error response
  FE --> Tenant : Show error
end

S -> S : (6) requireActivatableTenant(phone)\n(status must be NEEDS_ACTIVATION)

S -> OTP : (7) verifyOrThrow(phone, otp, TENANT_ACTIVATION, referenceId)
activate OTP
OTP -> OVR : (8) findTopBy...VerifiedFalseOrderByCreatedAtDesc
activate OVR
OVR -> DB : (9) SELECT OtpVerification
DB --> OVR : (10) otp / empty
OVR --> OTP : (11) OtpVerification?
deactivate OVR

alt OTP missing / expired / attempts exceeded
  OTP --> S : BusinessException
  S --> C : Exception
  C --> FE : Error response
  FE --> Tenant : Show error
else Code does not match
  OTP -> OVR : (12) save(attemptCount + 1)
  OVR -> DB : (13) UPDATE OtpVerification
  OTP --> S : BusinessException("OTP incorrect")
else Code matches
  OTP -> OVR : (14) save(verified = true)
  OVR -> DB : (15) UPDATE OtpVerification
  DB --> OVR : (16) OK
end
OTP --> S : (17) verified
deactivate OTP

S -> PE : (18) encode(newPassword)
PE --> S : (19) hash
S -> UR : (20) save(user: password, isFirstLogin = false)
activate UR
UR -> DB : (21) UPDATE User
DB --> UR : (22) OK
UR --> S : (23) saved
deactivate UR

S -> UDS : (24) loadUserByUsername(username)
activate UDS
UDS --> S : (25) UserDetails
deactivate UDS
S -> JWT : (26) generateToken(userDetails)
JWT --> S : (27) jwt

break Business / system error
  S -> DB : RollbackTransaction()
  DB --> S : Rolled back
  S --> C : Exception
  C --> FE : Error response
  FE --> Tenant : Show error
end

S -> DB : (28) CommitTransaction()
DB --> S : (29) Committed
deactivate DB

S --> C : (30) AuthResponse (jwt, username, role, false)
deactivate S
C --> FE : (31) 200 OK + AuthResponse
deactivate C
FE --> Tenant : (32) Store token, navigate to home

@enduml
