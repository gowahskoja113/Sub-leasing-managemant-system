@startuml HostDashboardAndFinanceReports
title Figure — HostDashboardAndFinanceReports (Owner Dashboard, Cash Flow, P&L, Receivables) Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor Host
participant "Front-end" as FE
participant "HostController" as C
participant "HostPortalServiceImpl" as S
participant "TenantInvoiceRepository" as TIR
participant "HostExpenseRepository" as HER
participant "RoomRepository" as RR
participant "TenantContractRepository" as TCR
participant "PropertyRepository" as PR
participant "UserRepository" as UR
database DB

== Dashboard summary of a month ==
Host -> FE : (1) Open the owner dashboard, choose month
FE -> C : (2) GET /api/v1/host/dashboard/summary?month=
activate C
C -> S : (3) getDashboardSummary(month)
activate S

S -> TIR : (4) sumTenantRevenue(month) and previous month
activate TIR
TIR -> DB : (5) SELECT SUM of PAID tenant invoices
DB --> TIR : (6) revenue
TIR --> S : (7) revenue, prevRevenue
deactivate TIR

S -> HER : (8) sumTotalExpense(month) and previous month\n(LEASE cost + host expenses)
activate HER
HER -> DB : (9) SELECT SUM HostExpense, MasterLease
DB --> HER : (10) expense
HER --> S : (11) expense, prevExpense
deactivate HER

S -> RR : (12) count rooms by status\n(total / RENTED / MAINTENANCE / AVAILABLE)
activate RR
RR -> DB : (13) SELECT COUNT Room
DB --> RR : (14) counts
RR --> S : (15) counts
deactivate RR

S -> TCR : (16) findByStatus(PENDING) + expiring master leases
TCR -> DB : (17) SELECT TenantContract, MasterLease
DB --> TCR : (18) rows
TCR --> S : (19) pending contracts, expiring leases
S -> UR : (20) findByRoleAndStatus(MANAGER, ACTIVE)
UR -> DB : (21) SELECT User
DB --> UR : (22) active managers
UR --> S : (23) count
S -> S : (24) net profit, change %, occupancy rate,\noutstanding (UNPAID + OVERDUE) invoices

alt Invalid month format
  S --> C : BusinessException
  C --> FE : Error response
  FE --> Host : Show error
end

S --> C : (25) HostDashboardSummaryResponse
deactivate S
C --> FE : (26) 200 OK
deactivate C
FE --> Host : (27) Show finance cards, occupancy, counters

== Cash flow, expense breakdown, property P&L ==
Host -> FE : (28) Open finance tabs
FE -> C : (29) GET /api/v1/host/finance/cashflow?from=&to=
C -> S : (30) getCashflow(from, to)
loop each month in [from, to]
  S -> TIR : (31) sumTenantRevenue(month)
  S -> HER : (32) sumTotalExpense(month)
end
S --> C : (33) HostCashflowResponse (series)
C --> FE : (34) 200 OK

FE -> C : (35) GET /api/v1/host/finance/expense-breakdown?month=
C -> S : (36) getExpenseBreakdown(month)
S -> HER : (37) sumAmountByCategoryForMonth(month) + lease expense
HER -> DB : (38) SELECT SUM GROUP BY category
S --> C : (39) HostExpenseBreakdownResponse
C --> FE : (40) 200 OK

FE -> C : (41) GET /api/v1/host/finance/property-pnl?month=
C -> S : (42) getPropertyPnl(month)
S -> PR : (43) findAll()
PR -> DB : (44) SELECT Property
loop each property
  S -> TIR : (45) sumTenantRevenueForProperty(propertyId, month)
  S -> HER : (46) lease cost + other expense for property
  S -> S : (47) net = revenue - total expense, margin %
end
S --> C : (48) HostPropertyPnlResponse (rows + totals)
C --> FE : (49) 200 OK

== Receivables aging ==
FE -> C : (50) GET /api/v1/host/finance/receivables-aging?month=
C -> S : (51) getReceivablesAging(month)
S -> TIR : (52) findForManager(RENT invoices of the month)
TIR -> DB : (53) SELECT TenantInvoice
DB --> TIR : (54) invoices
S -> S : (55) skip PAID; bucket by days past due:\nnot due / 0-30 / 31-60 / 61-90 / >90
S --> C : (56) HostReceivablesAgingResponse
C --> FE : (57) 200 OK
FE --> Host : (58) Show charts and tables

note over S
  Same service also provides financial summary, manager performance
  and property performance reports (getFinancialSummary,
  getManagerPerformance, getPropertyPerformance), host notifications
  and contract price approval (see HostApproveContractPrice).
end note

@enduml
