@startuml Login
title Figure — Login Sequence Diagram

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam ParticipantPadding 8
skinparam BoxPadding 6

actor User
participant "Front-end" as FE
participant "AuthController" as C
participant "AuthServiceImpl" as S
participant "UserRepository" as UR
participant "AuthenticationManager" as AM
participant "CustomUserDetailsService" as UDS
participant "JwtUtil" as JWT
database DB

User -> FE : (1) Enter username/phone + password\nClick "Login"
FE -> C : (2) POST /api/v1/auth/login\nAuthRequest
activate C
C -> S : (3) login(request)
activate S

S -> UR : (4) findByUsername / findByPhoneNumber\n(rejectUnactivatedTenantLogin)
activate UR
UR -> DB : (5) SELECT User
DB --> UR : (6) User / empty
UR --> S : (7) User?
deactivate UR

alt Tenant with isFirstLogin = true
  S --> C : BusinessException\n(account not activated)
  C --> FE : Error response
  FE --> User : Show error / redirect to activation
end

S -> UR : (8) findByUsername(username)
activate UR
UR -> DB : (9) SELECT User
DB --> UR : (10) User
UR --> S : (11) User
deactivate UR

alt status = DISABLE
  S --> C : BusinessException\n(account disabled)
  C --> FE : Error response
  FE --> User : Show error
end

S -> AM : (12) authenticate(username, password)
activate AM
AM --> S : (13) Authentication OK /\nBadCredentialsException
deactivate AM

alt Bad credentials
  S --> C : Exception
  C --> FE : 401 Unauthorized
  FE --> User : Show error
end

S -> UDS : (14) loadUserByUsername(username)
activate UDS
UDS -> DB : (15) SELECT User + authorities
DB --> UDS : (16) User
UDS --> S : (17) UserDetails
deactivate UDS

S -> JWT : (18) generateToken(userDetails)
activate JWT
JWT --> S : (19) jwt
deactivate JWT

S --> C : (20) AuthResponse\n(jwt, username, role, isFirstLogin)
deactivate S
C --> FE : (21) 200 OK + AuthResponse
deactivate C
FE --> User : (22) Store token, navigate to home by role

@enduml
