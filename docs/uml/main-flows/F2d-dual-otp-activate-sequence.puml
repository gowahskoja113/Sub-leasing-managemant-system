@startuml F2d_DualOtpActivate_Sequence
title Figure F2d — Dual OTP (Tenant + Manager) → Activate

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Tenant
actor Manager
participant "Front-end" as FE
participant "TenantMyContractController" as TMC
participant "TenantContractActionController" as AC
participant "TenantOnboardingServiceImpl" as S
participant "OtpService" as OTP
participant "TenantContractRepository" as CR
database DB

Tenant -> FE : (1) Send dual confirm OTP
activate Tenant
activate FE
FE -> TMC : (2) POST /api/v1/tenant/me/contracts/{id}/send-confirm-otp
activate TMC
TMC -> S : (3) sendDualContractConfirmOtps(id)
activate S
S -> OTP : (4) send SMS\n(CONTRACT_CONFIRM_TENANT\n+ CONTRACT_CONFIRM_MANAGER)
activate OTP
OTP --> S : (5) return OK
deactivate OTP
S --> TMC : (6) return OK
deactivate S
TMC --> FE : (7) return OK
deactivate TMC
deactivate FE
deactivate Tenant

Tenant -> FE : (8) Enter tenant OTP
activate Tenant
activate FE
FE -> TMC : (9) POST .../confirm-otp {otp}
activate TMC
TMC -> S : (10) confirmContractByTenant(id, otp)
activate S
S -> OTP : (11) verify OTP tenant
activate OTP
OTP --> S : (12) return valid
deactivate OTP
S -> CR : (13) save tenantOtpVerifiedAt
activate CR
CR -> DB : (14) UPDATE
activate DB
DB --> CR : (15) return OK
deactivate DB
CR --> S : (16) return OK
deactivate CR
S --> TMC : (17) return Response\n(not ACTIVE until manager OTP)
deactivate S
TMC --> FE : (18) return OK
deactivate TMC
FE --> Tenant : (19) return Tenant OTP OK
deactivate FE
deactivate Tenant

Manager -> FE : (20) Enter manager OTP
activate Manager
activate FE
FE -> AC : (21) POST /api/v1/tenant-contracts/{id}/confirm {otp}
activate AC
AC -> S : (22) confirmContract(id, otp)
activate S
S -> DB : (23) BeginTransaction()
activate DB
S -> OTP : (24) verify OTP manager
activate OTP
OTP --> S : (25) return valid
deactivate OTP
S -> S : (26) both OTPs verified\n→ activateContract()
S -> CR : (27) UPDATE status=ACTIVE,\nactivatedAt, room→RENTED
activate CR
CR -> DB : (28) UPDATE
DB --> CR : (29) return OK
CR --> S : (30) return Contract
deactivate CR
break
  S -> DB : RollbackTransaction()
end
S -> DB : (31) CommitTransaction()
DB --> S : (32) return Committed
deactivate DB
S --> AC : (33) return TenantContractResponse ACTIVE
deactivate S
AC --> FE : (34) return Success
deactivate AC
FE --> Manager : (35) return Onboarding complete
FE --> Tenant : (36) return Contract activated
activate Tenant
deactivate Tenant
deactivate FE
deactivate Manager

@enduml
