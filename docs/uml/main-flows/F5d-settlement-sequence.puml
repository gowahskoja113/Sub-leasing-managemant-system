@startuml F5d_Settlement_Sequence
title Figure F5d — Settlement (Submit + Tenant Accept)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
actor Tenant
participant "Front-end" as FE
participant "CheckoutProcessController" as PC
participant "TenantCheckoutProcessController" as TPC
participant "CheckoutProcessServiceImpl" as PS
participant "CheckoutSettlementRepository" as SR
participant "CheckoutRequestRepository" as RR
database DB

Manager -> FE : (1) Submit settlement
activate Manager
activate FE
FE -> PC : (2) POST .../settlement/submit
activate PC
PC -> PS : (3) submitSettlement
activate PS
PS -> SR : (4) save(CheckoutSettlement\ndeposit - unpaid - damage)
activate SR
SR -> DB : (5) INSERT
activate DB
DB --> SR : (6) return OK
deactivate DB
SR --> PS : (7) return Settlement
deactivate SR
PS -> RR : (8) UPDATE WAITING_TENANT
activate RR
RR -> DB : (9) UPDATE
activate DB
DB --> RR : (10) return OK
deactivate DB
RR --> PS : (11) return OK
deactivate RR
PS --> PC : (12) return OK
deactivate PS
PC --> FE : (13) return OK
deactivate PC
FE --> Manager : (14) return Waiting for tenant
deactivate FE
deactivate Manager

Tenant -> FE : (15) Accept settlement
activate Tenant
activate FE
FE -> TPC : (16) POST /api/v1/tenant/me/checkout-requests/{id}/settlement/accept
activate TPC
TPC -> PS : (17) acceptSettlement(id, tenantId)
activate PS
PS -> RR : (18) UPDATE SETTLING
activate RR
RR -> DB : (19) UPDATE
activate DB
DB --> RR : (20) return OK
deactivate DB
RR --> PS : (21) return OK
deactivate RR
PS --> TPC : (22) return OK
deactivate PS
TPC --> FE : (23) return OK
deactivate TPC
FE --> Tenant : (24) return Settlement accepted
deactivate FE
deactivate Tenant

@enduml
