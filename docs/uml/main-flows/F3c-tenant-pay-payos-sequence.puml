@startuml F3c_TenantPayPayOS_Sequence
title Figure F3c — Tenant Pay via PayOS

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Tenant
participant "Front-end" as FE
participant "TenantMeController" as TC
participant "PayosWebhookController" as WC
participant "TenantBillingServiceImpl" as TBS
participant "PayosService" as PayOS
participant "TenantInvoiceRepository" as TIR
database DB

Tenant -> FE : (1) Pay invoice
activate Tenant
activate FE
FE -> TC : (2) POST /api/v1/tenant/me/invoices/{id}/payment
activate TC
TC -> TBS : (3) createPayment(invoiceId)
activate TBS
TBS -> PayOS : (4) createPaymentLink
activate PayOS
PayOS --> TBS : (5) return QR / orderCode
deactivate PayOS
TBS -> TIR : (6) save PayosOrder
activate TIR
TIR -> DB : (7) INSERT/UPDATE
activate DB
DB --> TIR : (8) return OK
deactivate DB
TIR --> TBS : (9) return OK
deactivate TIR
TBS --> TC : (10) return PaymentLinkResponse
deactivate TBS
TC --> FE : (11) return QR
deactivate TC
FE --> Tenant : (12) return Payment QR
deactivate FE

Tenant -> PayOS : (13) Pay success
activate PayOS
PayOS -> WC : (14) POST /api/v1/payos/webhook
activate WC
WC -> TBS : (15) markInvoicePaidByPayosOrderCode
activate TBS
TBS -> DB : (16) BeginTransaction()
activate DB
TBS -> TIR : (17) UPDATE TenantInvoice PAID\n+ INSERT TenantPayment
activate TIR
TIR -> DB : (18) UPDATE / INSERT
DB --> TIR : (19) return OK
TIR --> TBS : (20) return OK
deactivate TIR
TBS -> DB : (21) CommitTransaction()
DB --> TBS : (22) return Committed
deactivate DB
TBS --> WC : (23) return OK
deactivate TBS
WC --> PayOS : (24) return 200
deactivate WC
PayOS --> Tenant : (25) return Payment success
deactivate PayOS
deactivate Tenant

note over TBS
  Cron BillingCronServiceImpl.runDailySweep
  (08:00 Asia/Ho_Chi_Minh): issue rent + overdue reminders
end note

@enduml
