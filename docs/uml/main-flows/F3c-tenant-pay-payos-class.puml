@startuml F3c_TenantPayPayOS_Class
title Figure F3c — Tenant Pay via PayOS Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class TenantMeController {
  - tenantBillingService: TenantBillingService
  + createPayment(invoiceId: Long): PaymentLinkResponse
}

class PayosWebhookController {
  - tenantBillingService: TenantBillingService
  + handleWebhook(payload): void
}

interface TenantBillingService {
  + createPayment(invoiceId: Long): PaymentLinkResponse
  + markInvoicePaidByPayosOrderCode(orderCode: String): void
}

class TenantBillingServiceImpl {
  - tenantInvoiceRepository: TenantInvoiceRepository
  - payosService: PayosService
  + createPayment(invoiceId: Long): PaymentLinkResponse
  + markInvoicePaidByPayosOrderCode(orderCode: String): void
}

interface PayosService {
  + createPaymentLink(...): PayosLink
}

interface TenantInvoiceRepository
interface JpaRepository<T,ID>

class TenantInvoice {
  + id: Long
  + amount: BigDecimal
  + status: TenantInvoiceStatus
  + dueDate: LocalDate
}

class TenantPayment {
  + id: Long
  + amount: BigDecimal
  + paidAt: LocalDateTime
}

class TenantInvoicePayosOrder {
  + id: Long
  + orderCode: String
  + status: PayosOrderStatus
}

enum TenantInvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

note right of TenantBillingServiceImpl
  Cron BillingCronServiceImpl.runDailySweep
  (08:00 Asia/Ho_Chi_Minh)
end note

TenantMeController --> TenantBillingService
PayosWebhookController --> TenantBillingService
TenantBillingService <|.. TenantBillingServiceImpl
TenantBillingServiceImpl --> TenantInvoiceRepository
TenantBillingServiceImpl --> PayosService
TenantInvoiceRepository -up-|> JpaRepository
TenantInvoiceRepository ..> TenantInvoice
TenantInvoice "1" o-- "*" TenantPayment
TenantInvoice "1" o-- "*" TenantInvoicePayosOrder
TenantInvoice --> TenantInvoiceStatus

@enduml
