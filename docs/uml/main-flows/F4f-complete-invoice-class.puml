@startuml F4f_CompleteInvoice_Class
title Figure F4f — Complete + Invoice Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MaintenanceController {
  - maintenanceService: MaintenanceService
  + complete(id: Long, req: MaintenanceCompleteRequest): MaintenanceRequestResponse
}

class TenantMeController {
  - tenantBillingService: TenantBillingService
  + createPayment(invoiceId: Long): PaymentLinkResponse
}

class PayosWebhookController {
  - maintenanceService: MaintenanceService
  + handleWebhook(payload): void
}

class MaintenanceCompleteRequest {
  + resolutionNote: String
  + afterImages: List~String~
}

interface MaintenanceService {
  + complete(id: Long, req: MaintenanceCompleteRequest): MaintenanceRequestResponse
  + closeWaitingPaymentAfterInvoicePaid(...): void
}

class MaintenanceServiceImpl {
  - tenantPendingChargeService: TenantPendingChargeService
  + complete(...): MaintenanceRequestResponse
  + closeWaitingPaymentAfterInvoicePaid(...): void
}

interface TenantPendingChargeService {
  + issueInvoice(due: LocalDate): TenantInvoice
}

interface TenantBillingService {
  + createPayment(invoiceId: Long): PaymentLinkResponse
}

class MaintenanceRequest {
  + id: Long
  + status: MaintenanceStatus
  + chargeInvoiceId: Long
}

class EquipmentMaintenanceHistory {
  + id: Long
  + maintenanceDate: LocalDateTime
  + repairCost: Long
  + note: String
}

class TenantInvoice {
  + id: Long
  + dueDate: LocalDate
  + status: TenantInvoiceStatus
}

class Equipment {
  + id: Long
  + maintenanceCount: int
}

enum MaintenanceStatus {
  CLOSED
  WAITING_PAYMENT
}

MaintenanceController --> MaintenanceService
MaintenanceController ..> MaintenanceCompleteRequest
TenantMeController --> TenantBillingService
PayosWebhookController --> MaintenanceService
MaintenanceService <|.. MaintenanceServiceImpl
MaintenanceServiceImpl --> TenantPendingChargeService
MaintenanceRequest "0..1" .. "0..1" TenantInvoice : chargeInvoiceId >
MaintenanceRequest "1" -- "*" EquipmentMaintenanceHistory
Equipment "1" o-- "*" EquipmentMaintenanceHistory
MaintenanceRequest --> MaintenanceStatus

@enduml
