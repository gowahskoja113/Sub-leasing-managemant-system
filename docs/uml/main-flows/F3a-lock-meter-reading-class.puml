@startuml F3a_LockMeterReading_Class
title Figure F3a — Manager Lock Meter Reading Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MeterReadingController {
  - meterReadingService: MeterReadingService
  + saveLocked(req: SaveMeterReadingRequest): SavedMeterReadingItem
}

class SaveMeterReadingRequest {
  + propertyId: Long
  + roomId: Long
  + utilityType: String
  + period: String
  + prevReading: BigDecimal
  + newReading: BigDecimal
  + meterImageUrl: String
  + overrideToken: UUID
}

interface MeterReadingService {
  + saveLockedReading(req: SaveMeterReadingRequest): SavedMeterReadingItem
}

class MeterReadingServiceImpl {
  - meterReadingRepository: MeterReadingRepository
  - utilityInvoiceService: UtilityInvoiceService
  + saveLockedReading(req): SavedMeterReadingItem
}

interface UtilityInvoiceService {
  + issueFromSavedReading(...): void
}

interface MeterReadingRepository
interface JpaRepository<T,ID>

class MeterReading {
  + id: Long
  + utilityType: UtilityType
  + period: String
  + prevReading: BigDecimal
  + reading: BigDecimal
  + imageUrl: String
}

class UtilityInvoice {
  + id: Long
  + amount: BigDecimal
  + status: UtilityInvoiceStatus
}

class TenantInvoice {
  + id: Long
  + status: TenantInvoiceStatus
}

note right of MeterReadingServiceImpl
  «@Transactional»
  opt: auto-issue invoice
  nếu UtilityBill đã PUBLISHED
end note

MeterReadingController --> MeterReadingService
MeterReadingController ..> SaveMeterReadingRequest
MeterReadingService <|.. MeterReadingServiceImpl
MeterReadingServiceImpl --> MeterReadingRepository
MeterReadingServiceImpl --> UtilityInvoiceService
MeterReadingRepository -up-|> JpaRepository
MeterReadingRepository ..> MeterReading
MeterReading ..> UtilityInvoice
UtilityInvoice ..> TenantInvoice

@enduml
