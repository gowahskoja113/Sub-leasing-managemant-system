@startuml F5e_OwnerRefund_Sequence
title Figure F5e — Owner Record Refund

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Owner
participant "Front-end" as FE
participant "CheckoutProcessController" as PC
participant "CheckoutProcessServiceImpl" as PS
participant "CheckoutSettlementRepository" as SR
participant "DepositAuditLogRepository" as DR
database DB

Owner -> FE : (1) Record refund + proof
activate Owner
activate FE
FE -> PC : (2) POST /api/v1/checkout-requests/{id}/refund
activate PC
PC -> PS : (3) refund(CheckoutRefundRequest)
activate PS
PS -> DB : (4) BeginTransaction()
activate DB
PS -> SR : (5) UPDATE refundAmount, proofUrl
activate SR
SR -> DB : (6) UPDATE
DB --> SR : (7) return OK
SR --> PS : (8) return OK
deactivate SR
PS -> DR : (9) INSERT DepositAuditLog
activate DR
DR -> DB : (10) INSERT
DB --> DR : (11) return OK
DR --> PS : (12) return OK
deactivate DR
break
  PS -> DB : RollbackTransaction()
end
PS -> DB : (13) CommitTransaction()
DB --> PS : (14) return Committed
deactivate DB
PS --> PC : (15) return DepositRefundResponse
deactivate PS
PC --> FE : (16) return OK
deactivate PC
FE --> Owner : (17) return Refund recorded
deactivate FE
deactivate Owner

@enduml
