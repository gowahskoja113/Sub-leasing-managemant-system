@startuml F4a_CreateRequest_Class
title Figure F4a — Tenant Create Maintenance Request Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MaintenanceController {
  - maintenanceService: MaintenanceService
  + create(req: MaintenanceCreateRequest): MaintenanceRequestResponse
}

class MaintenanceCreateRequest {
  + propertyId: Long
  + roomId: Long
  + equipmentId: Long
  + title: String
  + description: String
  + visitAppointmentAt: LocalDateTime
  + photoUrls: List~String~
}

interface MaintenanceService {
  + createRequest(req: MaintenanceCreateRequest): MaintenanceRequestResponse
}

class MaintenanceServiceImpl {
  + createRequest(req: MaintenanceCreateRequest): MaintenanceRequestResponse
}

class MaintenanceRequest {
  + id: Long
  + status: MaintenanceStatus
  + title: String
  + description: String
}

class MaintenanceImage {
  + id: Long
  + url: String
  + photoType: MaintenancePhotoType
}

enum MaintenanceStatus {
  OPEN
}

enum MaintenancePhotoType {
  BEFORE
}

MaintenanceController --> MaintenanceService
MaintenanceController ..> MaintenanceCreateRequest
MaintenanceService <|.. MaintenanceServiceImpl
MaintenanceRequest "1" o-- "*" MaintenanceImage
MaintenanceRequest --> MaintenanceStatus
MaintenanceImage --> MaintenancePhotoType

@enduml
