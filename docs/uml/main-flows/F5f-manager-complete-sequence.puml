@startuml F5f_ManagerComplete_Sequence
title Figure F5f — Manager Complete Checkout

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
actor Tenant
participant "Front-end" as FE
participant "CheckoutRequestController" as CC
participant "TenantCheckoutServiceImpl" as CS
participant "CheckoutRequestRepository" as RR
database DB

Manager -> FE : (1) Complete checkout
activate Manager
activate FE
FE -> CC : (2) POST /api/v1/checkout-requests/{id}/complete
activate CC
CC -> CS : (3) completeRequest(...)
activate CS
CS -> DB : (4) BeginTransaction()
activate DB
CS -> RR : (5) UPDATE COMPLETED
activate RR
RR -> DB : (6) UPDATE
DB --> RR : (7) return OK
RR --> CS : (8) return OK
deactivate RR
CS -> CS : (9) terminateActiveContract,\nroom → AVAILABLE
CS -> DB : (10) CommitTransaction()
DB --> CS : (11) return Committed
deactivate DB
CS --> CC : (12) return CheckoutResponse
deactivate CS
CC --> FE : (13) return Done
deactivate CC
FE --> Manager : (14) return Completed
FE --> Tenant : (15) return Checkout complete
activate Tenant
deactivate Tenant
deactivate FE
deactivate Manager

@enduml
