@startuml F4_Maintenance_State
title Maintenance Ticket State\nBoxes = MaintenanceStatus · Arrows = actions from code

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #CCCCCC
skinparam ArrowFontColor #FFFFFF
skinparam ArrowFontSize 12
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #FFFFFF
  FontColor #000000
  FontSize 14
  FontStyle bold
}

[*] --> OPEN : Tenant create\nPOST /

OPEN --> REPAIR_SCHEDULED : Manager diagnose / inspect\nPUT /diagnose\nor PUT /send-for-inspection
OPEN --> CANCELLED : Cancel\nPUT /cancel

REPAIR_SCHEDULED --> IN_REPAIR : Manager start repair\nPUT /start-repair\n[WEAR / company pays]
REPAIR_SCHEDULED --> TENANT_FAULT : Manager start repair\nPUT /start-repair\n[tenant pays]
REPAIR_SCHEDULED --> CANCELLED : Cancel\nPUT /cancel

IN_REPAIR --> WAITING_PAYMENT : Manager complete\n+ issue invoice\nPUT /complete
TENANT_FAULT --> WAITING_PAYMENT : Manager complete\n+ issue invoice\nPUT /complete

WAITING_PAYMENT --> CLOSED : Tenant pay invoice\nPayOS / webhook PAID

CLOSED --> [*]

@enduml
