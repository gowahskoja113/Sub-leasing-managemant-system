@startuml F2c_DepositPayOS_Sequence
title Figure F2c — Deposit via PayOS + Webhook

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
actor Tenant
participant "Front-end" as FE
participant "TenantContractActionController" as AC
participant "PayosWebhookController" as WC
participant "TenantOnboardingServiceImpl" as S
participant "PayosService" as PayOS
participant "TenantContractRepository" as CR
database DB

Manager -> FE : (1) Create deposit QR\n(deposit + first-rent pro-rata)
activate Manager
activate FE
FE -> AC : (2) POST /api/v1/tenant-contracts/{id}/deposit-payment
activate AC
AC -> S : (3) createDepositPayment(contractId)
activate S
S -> PayOS : (4) createPaymentLink
activate PayOS
PayOS --> S : (5) return checkoutUrl / orderCode
deactivate PayOS
S -> CR : (6) save(payosOrderCode,\nstatus=PENDING, payment=PENDING)
activate CR
CR -> DB : (7) UPDATE
activate DB
DB --> CR : (8) return OK
deactivate DB
CR --> S : (9) return OK
deactivate CR
S --> AC : (10) return TenantContractResponse
deactivate S
AC --> FE : (11) return QR
deactivate AC
FE --> Tenant : (12) return Pay deposit
activate Tenant
deactivate FE
deactivate Manager

Tenant -> PayOS : (13) Pay success
activate PayOS
PayOS -> WC : (14) POST /api/v1/payos/webhook
activate WC
WC -> S : (15) markDepositPaid(orderCode)
activate S
S -> DB : (16) BeginTransaction()
activate DB
S -> CR : (17) UPDATE paymentStatus=PAID\n(+ TenantInvoice OTHER if any)
activate CR
CR -> DB : (18) UPDATE / INSERT
DB --> CR : (19) return OK
CR --> S : (20) return OK
deactivate CR
S -> DB : (21) CommitTransaction()
DB --> S : (22) return Committed
deactivate DB
S --> WC : (23) return OK
deactivate S
WC --> PayOS : (24) return 200 OK
deactivate WC
PayOS --> Tenant : (25) return Deposit PAID
deactivate PayOS
deactivate Tenant

@enduml
