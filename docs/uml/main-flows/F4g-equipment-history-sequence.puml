@startuml F4g_EquipmentHistory_Sequence
title Figure F4g — View Equipment History

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Admin
actor Tenant
participant "Front-end" as FE
participant "EquipmentController" as EC

Admin -> FE : (1) Open equipment management
activate Admin
activate FE
FE -> EC : (2) GET /api/v1/equipment/{id}\nGET .../maintenance-history
activate EC
EC --> FE : (3) return depreciation, warranty,\nhistory + photos
deactivate EC
FE --> Admin : (4) return History
deactivate FE
deactivate Admin

Tenant -> FE : (5) Mobile: my equipments
activate Tenant
activate FE
FE -> EC : (6) GET /tenant/me/equipments\nGET .../{id}/maintenance-history
activate EC
EC --> FE : (7) return same info + photos
deactivate EC
FE --> Tenant : (8) return History
deactivate FE
deactivate Tenant

@enduml
