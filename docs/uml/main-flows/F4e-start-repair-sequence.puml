@startuml F4e_StartRepair_Sequence
title Figure F4e — Repair (payment not required)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
participant "Front-end" as FE
participant "MaintenanceController" as C
participant "MaintenanceServiceImpl" as S
database DB

Manager -> FE : (1) Start repair
activate Manager
activate FE
FE -> C : (2) PUT /api/v1/maintenance/{id}/start-repair
activate C
C -> S : (3) startRepair\n(REPAIR_SCHEDULED → IN_REPAIR / TENANT_FAULT)
activate S
S -> DB : (4) UPDATE status
activate DB
DB --> S : (5) return OK
deactivate DB
S --> C : (6) return OK
deactivate S
C --> FE : (7) return Response
deactivate C
FE --> Manager : (8) return In repair
deactivate FE
deactivate Manager

@enduml
