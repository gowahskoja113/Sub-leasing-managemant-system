@startuml F4b_ViewTicket_Class
title Figure F4b — Manager View Ticket Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MaintenanceController {
  - maintenanceService: MaintenanceService
  + getById(id: Long): MaintenanceRequestResponse
}

interface MaintenanceService {
  + getRequestById(id: Long): MaintenanceRequestResponse
}

class MaintenanceServiceImpl {
  - equipmentService: EquipmentService
  + getRequestById(id: Long): MaintenanceRequestResponse
}

interface EquipmentService
class EquipmentServiceImpl {
  + getSnapshot(equipmentId: Long): Equipment
}

class MaintenanceRequest {
  + id: Long
  + status: MaintenanceStatus
  + equipmentId: Long
}

class Equipment {
  + id: Long
  + name: String
  + maintenanceCount: int
  + remainingDepreciationAmount: BigDecimal
  + warrantyMonths: Integer
  + remainingWarrantyLabel: String
  + qrCode: String
}

note right of MaintenanceServiceImpl
  returns qrScanRequiredToProcess=true
end note

MaintenanceController --> MaintenanceService
MaintenanceService <|.. MaintenanceServiceImpl
MaintenanceServiceImpl --> EquipmentService
EquipmentService <|.. EquipmentServiceImpl
Equipment "0..1" o-- "*" MaintenanceRequest

@enduml
