@startuml F5c_InspectionDamages_Sequence
title Figure F5c — Inspection + Damages

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
participant "Front-end" as FE
participant "CheckoutProcessController" as PC
participant "CheckoutProcessServiceImpl" as PS
participant "CheckoutInspectionRepository" as IR
participant "CheckoutRequestRepository" as RR
database DB

Manager -> FE : (1) Inspection + damages
activate Manager
activate FE
FE -> PC : (2) POST /api/v1/checkout-requests/{id}/inspection
activate PC
PC -> PS : (3) saveInspection(req)
activate PS
PS -> DB : (4) BeginTransaction()
activate DB
PS -> IR : (5) save(CheckoutInspection\n+ DamageItems)
activate IR
IR -> DB : (6) INSERT
DB --> IR : (7) return OK
IR --> PS : (8) return OK
deactivate IR
PS -> RR : (9) UPDATE status=INSPECTING
activate RR
RR -> DB : (10) UPDATE
DB --> RR : (11) return OK
RR --> PS : (12) return OK
deactivate RR
PS -> DB : (13) CommitTransaction()
DB --> PS : (14) return Committed
deactivate DB
PS --> PC : (15) return OK
deactivate PS
PC --> FE : (16) return OK
deactivate PC
FE --> Manager : (17) return Inspection saved
deactivate FE
deactivate Manager

@enduml
