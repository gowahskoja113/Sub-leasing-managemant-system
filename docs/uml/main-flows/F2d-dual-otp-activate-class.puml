@startuml F2d_DualOtpActivate_Class
title Figure F2d — Dual OTP → Activate Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class TenantMyContractController {
  - tenantOnboardingService: TenantOnboardingService
  + sendConfirmOtp(id: Long): void
  + confirmOtp(id: Long, otp: String): TenantContractResponse
}

class TenantContractActionController {
  - tenantOnboardingService: TenantOnboardingService
  + confirm(id: Long, otp: String): TenantContractResponse
}

interface TenantOnboardingService {
  + sendDualContractConfirmOtps(id: Long): void
  + confirmContractByTenant(id: Long, otp: String): TenantContractResponse
  + confirmContract(id: Long, otp: String): TenantContractResponse
}

class TenantOnboardingServiceImpl {
  - tenantContractRepository: TenantContractRepository
  - otpService: OtpService
  + sendDualContractConfirmOtps(id: Long): void
  + confirmContractByTenant(id: Long, otp: String): TenantContractResponse
  + confirmContract(id: Long, otp: String): TenantContractResponse
}

interface OtpService {
  + sendSms(...): void
  + verifyOtp(...): boolean
}

interface TenantContractRepository
interface JpaRepository<T,ID>

class TenantContract {
  + id: Long
  + status: ContractStatus
  + tenantOtpVerifiedAt: LocalDateTime
  + activatedAt: LocalDateTime
}

class Room {
  + id: Long
  + status: RoomStatus
}

enum ContractStatus {
  PENDING_CONFIRM
  ACTIVE
}

enum RoomStatus {
  AVAILABLE
  RENTED
}

note right of TenantOnboardingServiceImpl
  «@Transactional»
  both OTPs verified
  → activateContract()
end note

TenantMyContractController --> TenantOnboardingService
TenantContractActionController --> TenantOnboardingService
TenantOnboardingService <|.. TenantOnboardingServiceImpl
TenantOnboardingServiceImpl --> TenantContractRepository
TenantOnboardingServiceImpl --> OtpService
TenantContractRepository -up-|> JpaRepository
TenantContractRepository ..> TenantContract
Room "0..1" o-- "*" TenantContract
TenantContract --> ContractStatus
Room --> RoomStatus

@enduml
