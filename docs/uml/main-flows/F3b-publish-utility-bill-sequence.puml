@startuml F3b_PublishUtilityBill_Sequence
title Figure F3b — Admin Publish EVN/Water Bill

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Admin
participant "Front-end" as FE
participant "AdminUtilityBillController" as AC
participant "UtilityBillServiceImpl" as UBS
participant "UtilityInvoiceService" as UIS
participant "UtilityBillRepository" as UBR
database DB

Admin -> FE : (1) Publish UtilityBill
activate Admin
activate FE
FE -> AC : (2) POST /api/v1/admin/utility-bills
activate AC
AC -> UBS : (3) createUtilityBill(req)
activate UBS
UBS -> DB : (4) BeginTransaction()
activate DB
UBS -> UBR : (5) save(status=PUBLISHED)
activate UBR
UBR -> DB : (6) INSERT UtilityBill
DB --> UBR : (7) return OK
UBR --> UBS : (8) return UtilityBill
deactivate UBR
UBS -> UIS : (9) issueElectric/WaterFromSavedReadings
activate UIS
UIS -> DB : (10) INSERT invoices from locked readings
DB --> UIS : (11) return OK
UIS --> UBS : (12) return issued
deactivate UIS
UBS -> DB : (13) CommitTransaction()
DB --> UBS : (14) return Committed
deactivate DB
UBS --> AC : (15) return UtilityBillResponse
deactivate UBS
AC --> FE : (16) return OK
deactivate AC
FE --> Admin : (17) return Published + invoices issued
deactivate FE
deactivate Admin

@enduml
