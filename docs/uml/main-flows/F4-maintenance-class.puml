@startuml F4_Maintenance_Class
title Figure — Maintenance Class Diagram\nUML 2.1 — Happy path Submit → Diagnose → Repair → Complete

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

together {
  class MaintenanceController {
    - maintenanceService: MaintenanceService
    + create(req: MaintenanceCreateRequest): MaintenanceResponse
    + confirmArrival(id: Long): MaintenanceResponse
    + diagnose(id: Long, req: MaintenanceDiagnoseRequest): MaintenanceResponse
    + approve(id: Long, req: MaintenanceApproveRequest): MaintenanceResponse
    + startRepair(id: Long): MaintenanceResponse
    + complete(id: Long, req: MaintenanceCompleteRequest): MaintenanceResponse
    + reportFault(id: Long, req: MaintenanceReportFaultRequest): MaintenanceResponse
    + adminReview(id: Long, req: MaintenanceAdminReviewRequest): MaintenanceResponse
  }

  class MaintenanceCreateRequest {
    + propertyId: Long
    + roomId: Long
    + title: String
    + description: String
    + category: String
    + priority: String
    + visitAppointmentAt: LocalDateTime
    + photoUrls: List~String~
  }

  class MaintenanceDiagnoseRequest {
    + diagnosis: String
    + damageCause: DamageCause
    + estimatedCost: BigDecimal
    + flowType: MaintenanceFlowType
  }

  class MaintenanceCompleteRequest {
    + resolutionNote: String
    + actualCost: BigDecimal
    + costPaidBy: CostPaidBy
    + handoverPhotoUrls: List~String~
  }
}

together {
  interface MaintenanceService
  class MaintenanceServiceImpl {
    - maintenanceRequestRepository: MaintenanceRequestRepository
    - maintenanceImageRepository: MaintenanceImageRepository
    - maintenanceHistoryRepository: MaintenanceHistoryRepository
    - equipmentRepository: EquipmentRepository
    - tenantBillingService: TenantBillingService
    + create(...): MaintenanceResponse
    + diagnose(...): MaintenanceResponse
    + approve(...): MaintenanceResponse
    + complete(...): MaintenanceResponse
    + reportFault(...): MaintenanceResponse
  }
}

note right of MaintenanceServiceImpl
  «@Transactional»
  Realtime notify tenant/manager
  Branch tenant-fault → admin-review
end note

together {
  interface MaintenanceRequestRepository
  interface MaintenanceImageRepository
  interface MaintenanceHistoryRepository
  interface EquipmentRepository
  interface OutstandingDamageRecordRepository
}

interface JpaRepository<T,ID>
MaintenanceRequestRepository --|> JpaRepository
MaintenanceImageRepository --|> JpaRepository
MaintenanceHistoryRepository --|> JpaRepository
EquipmentRepository --|> JpaRepository
OutstandingDamageRecordRepository --|> JpaRepository

together {
  class MaintenanceRequest {
    + id: Long
    + requestCode: String
    + title: String
    + description: String
    + status: MaintenanceStatus
    + flowType: MaintenanceFlowType
    + damageCause: DamageCause
    + faultResolutionPath: FaultResolutionPath
    + estimatedCost: BigDecimal
    + actualCost: BigDecimal
    + chargeInvoiceId: Long
    + createdAt: LocalDateTime
    + doneAt: LocalDateTime
  }

  class MaintenanceImage {
    + id: Long
    + url: String
    + photoType: MaintenancePhotoType
  }

  class MaintenanceHistory {
    + id: Long
    + action: String
    + note: String
    + createdAt: LocalDateTime
  }

  class Equipment {
    + id: Long
    + name: String
    + status: EquipmentStatus
  }

  class EquipmentMaintenanceHistory {
    + id: Long
    + note: String
  }

  class OutstandingDamageRecord {
    + id: Long
    + amount: BigDecimal
    + settled: Boolean
  }

  class Tenant
  class Property
  class Room
  class TenantContract

  enum MaintenanceStatus {
    OPEN
    VISITING
    DIAGNOSED
    REPAIRING
    COMPLETED
    ...
  }
}

MaintenanceController --> MaintenanceService
MaintenanceController ..> MaintenanceCreateRequest
MaintenanceController ..> MaintenanceDiagnoseRequest
MaintenanceController ..> MaintenanceCompleteRequest
MaintenanceService <|.. MaintenanceServiceImpl
MaintenanceServiceImpl --> MaintenanceRequestRepository
MaintenanceServiceImpl --> MaintenanceImageRepository
MaintenanceServiceImpl --> MaintenanceHistoryRepository
MaintenanceServiceImpl --> EquipmentRepository
MaintenanceServiceImpl --> TenantBillingService

Tenant "1" o-- "*" MaintenanceRequest
Property "1" o-- "*" MaintenanceRequest
Room "0..1" o-- "*" MaintenanceRequest
TenantContract "0..1" o-- "*" MaintenanceRequest
Equipment "0..1" o-- "*" MaintenanceRequest
MaintenanceRequest "1" o-- "*" MaintenanceImage
MaintenanceRequest "1" o-- "*" MaintenanceHistory
Equipment "1" o-- "*" EquipmentMaintenanceHistory
MaintenanceRequest "0..1" o-- "0..1" OutstandingDamageRecord
MaintenanceRequest --> MaintenanceStatus

@enduml
