@startuml F4d_Diagnose_Class
title Figure F4d — Diagnose Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MaintenanceController {
  - maintenanceService: MaintenanceService
  + diagnose(id: Long, req: MaintenanceDiagnoseRequest): MaintenanceRequestResponse
}

class MaintenanceDiagnoseRequest {
  + damageCause: DamageCause
  + tenantAgreesToPay: Boolean
  + faultReason: String
}

interface MaintenanceService {
  + diagnose(id: Long, req: MaintenanceDiagnoseRequest): MaintenanceRequestResponse
}

class MaintenanceServiceImpl {
  + diagnose(id: Long, req: MaintenanceDiagnoseRequest): MaintenanceRequestResponse
}

class MaintenanceRequest {
  + id: Long
  + status: MaintenanceStatus
  + damageCause: DamageCause
  + tenantAgreesToPay: Boolean
}

enum DamageCause {
  WEAR
  TENANT_MISUSE
}

enum MaintenanceStatus {
  IN_REPAIR
  REPAIR_SCHEDULED
  TENANT_FAULT
}

note right of MaintenanceServiceImpl
  Invoice issued at complete —
  not at diagnose
end note

MaintenanceController --> MaintenanceService
MaintenanceController ..> MaintenanceDiagnoseRequest
MaintenanceService <|.. MaintenanceServiceImpl
MaintenanceRequest --> DamageCause
MaintenanceRequest --> MaintenanceStatus

@enduml
