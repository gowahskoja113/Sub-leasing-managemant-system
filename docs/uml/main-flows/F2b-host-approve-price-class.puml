@startuml F2b_HostApprovePrice_Class
title Figure F2b — Host Approve Price Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class HostController {
  - hostPortalService: HostPortalService
  + approveContract(id: Long): HostContractDto
}

interface HostPortalService {
  + approveContract(id: Long): HostContractDto
}

class HostPortalServiceImpl {
  - tenantContractRepository: TenantContractRepository
  + approveContract(id: Long): HostContractDto
}

interface TenantContractRepository
interface JpaRepository<T,ID>

class TenantContract {
  + id: Long
  + priceApprovalStatus: PriceApprovalStatus
}

enum PriceApprovalStatus {
  PENDING
  APPROVED_AWAITING_DEPOSIT
}

HostController --> HostPortalService
HostPortalService <|.. HostPortalServiceImpl
HostPortalServiceImpl --> TenantContractRepository
TenantContractRepository -up-|> JpaRepository
TenantContractRepository ..> TenantContract
TenantContract --> PriceApprovalStatus

@enduml
