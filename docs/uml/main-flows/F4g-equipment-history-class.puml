@startuml F4g_EquipmentHistory_Class
title Figure F4g — View Equipment History Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class EquipmentController {
  - equipmentService: EquipmentService
  + getById(id: Long): EquipmentResponse
  + getMaintenanceHistory(id: Long): List~EquipmentMaintenanceHistory~
  + getMyEquipments(): List~EquipmentResponse~
  + getMyMaintenanceHistory(id: Long): List~EquipmentMaintenanceHistory~
}

interface EquipmentService
class EquipmentServiceImpl

class Equipment {
  + id: Long
  + name: String
  + price: BigDecimal
  + warrantyMonths: Integer
  + warrantyEndDate: LocalDate
  + maintenanceCount: int
  + remainingDepreciationAmount: BigDecimal
}

class EquipmentMaintenanceHistory {
  + id: Long
  + maintenanceDate: LocalDateTime
  + repairCost: Long
  + note: String
  + photoUrls: String
}

EquipmentController --> EquipmentService
EquipmentService <|.. EquipmentServiceImpl
Equipment "1" o-- "*" EquipmentMaintenanceHistory

@enduml
