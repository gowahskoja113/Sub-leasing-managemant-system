@startuml F4c_ConfirmArrivalQr_Class
title Figure F4c — Confirm Arrival (QR) Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class MaintenanceController {
  - maintenanceService: MaintenanceService
  + confirmArrival(id: Long, req: MaintenanceConfirmArrivalRequest): MaintenanceRequestResponse
}

class MaintenanceConfirmArrivalRequest {
  + qrCode: String
}

interface MaintenanceService {
  + confirmArrival(id: Long, req: MaintenanceConfirmArrivalRequest): MaintenanceRequestResponse
}

class MaintenanceServiceImpl {
  + confirmArrival(id: Long, req: MaintenanceConfirmArrivalRequest): MaintenanceRequestResponse
  - assertQrMatchesEquipment(...): void
}

class MaintenanceRequest {
  + id: Long
  + visitArrivalConfirmedAt: LocalDateTime
  + equipmentId: Long
}

class Equipment {
  + id: Long
  + qrCode: String
}

MaintenanceController --> MaintenanceService
MaintenanceController ..> MaintenanceConfirmArrivalRequest
MaintenanceService <|.. MaintenanceServiceImpl
Equipment "0..1" o-- "*" MaintenanceRequest

@enduml
