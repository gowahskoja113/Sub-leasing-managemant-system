@startuml F1b_HostConfirm_Sequence
title Figure F1b — Host Confirm Pricing (auto-assign zone OM → ACTIVE)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Host
participant "Front-end" as FE
participant "PropertyOnboardingController" as C
participant "PropertyOnboardingServiceImpl" as S
participant "PropertyRepository" as PR
participant "RoomRepository" as RR
participant "ZoneManagerRepository" as ZMR
database DB

Host -> FE : (1) Confirm appliedPrice / roomPrices\n+ contingencyPercent
activate Host
activate FE
FE -> C : (2) POST /api/v1/properties/{id}/host-confirm
activate C
C -> S : (3) hostConfirm(id, HostConfirmRequest)
activate S
S -> DB : (4) BeginTransaction()
activate DB
S -> PR : (5) findById + validate PENDING_HOST_REVIEW
activate PR
PR -> DB : (6) SELECT Property
DB --> PR : (7) return Property
PR --> S : (8) return Property
deactivate PR
S -> ZMR : (9) findById(zoneId)\n(throw ZONE_HAS_NO_MANAGER if missing)
activate ZMR
ZMR -> DB : (10) SELECT ZoneManager
DB --> ZMR : (11) return ZoneManager
ZMR --> S : (12) return managerId
deactivate ZMR
S -> RR : (13) update room prices / appliedPrice
activate RR
RR -> DB : (14) UPDATE Room
DB --> RR : (15) return OK
RR --> S : (16) return OK
deactivate RR
S -> PR : (17) save(operationManagerId=zoneOM,\nstatus=ACTIVE, open DRAFT rooms)
activate PR
PR -> DB : (18) UPDATE Property + Room
DB --> PR : (19) return OK
PR --> S : (20) return Property
deactivate PR
S -> DB : (21) CommitTransaction()
DB --> S : (22) return Committed
deactivate DB
S --> C : (23) return PropertyActivationResponse
deactivate S
C --> FE : (24) return Response
deactivate C
FE --> Host : (25) return Property ACTIVE
deactivate FE
deactivate Host

@enduml
