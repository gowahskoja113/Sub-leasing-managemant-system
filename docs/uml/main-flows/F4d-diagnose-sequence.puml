@startuml F4d_Diagnose_Sequence
title Figure F4d — Diagnose (no invoice yet)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Manager
participant "Front-end" as FE
participant "MaintenanceController" as C
participant "MaintenanceServiceImpl" as S
database DB

Manager -> FE : (1) Diagnose\n(WEAR / TENANT_MISUSE)
activate Manager
activate FE
FE -> C : (2) PUT /api/v1/maintenance/{id}/diagnose
activate C
C -> S : (3) diagnose
activate S
note right of S
  Use tenant photos + on-site check.
  Tenant-fault invoice is issued
  at complete/handover — not at diagnose.
end note
alt [WEAR — company pays]
  S -> DB : (4) UPDATE IN_REPAIR\nor REPAIR_SCHEDULED
  activate DB
  DB --> S : (5) return OK
  deactivate DB
else [TENANT_MISUSE]
  S -> DB : (6) UPDATE TENANT_FAULT\n/ REPAIR_SCHEDULED\n(+ tenantAgreesToPay)
  activate DB
  DB --> S : (7) return OK
  deactivate DB
end
S --> C : (8) return Response\n(no issuedInvoice yet)
deactivate S
C --> FE : (9) return OK
deactivate C
FE --> Manager : (10) return Diagnosed
deactivate FE
deactivate Manager

@enduml
