@startuml ClassDiagram_F4d_Diagnose
title Figure F4d — Diagnose Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class MaintenanceController <<controller>> {
  -maintenanceService : MaintenanceService
  +diagnose(id: Long, request: MaintenanceDiagnoseRequest) : MaintenanceRequestResponse
}

interface MaintenanceService {
  +diagnose(id: Long, request: MaintenanceDiagnoseRequest) : MaintenanceRequestResponse
}

class MaintenanceServiceImpl <<service>> {
  -repository : MaintenanceRequestRepository
  -maintenanceTimelineRepository : MaintenanceTimelineRepository
  +diagnose(id: Long, request: MaintenanceDiagnoseRequest) : MaintenanceRequestResponse
}

interface MaintenanceRequestRepository {
  +findById(id: Long) : Optional<MaintenanceRequest>
  +save(r: MaintenanceRequest) : MaintenanceRequest
}

interface MaintenanceTimelineRepository {
  +save(t: MaintenanceTimeline) : MaintenanceTimeline
}

class MaintenanceDiagnoseRequest <<dto>> {
  -damageCause : DamageCause
  -faultReason : String
  -faultResolutionPath : FaultResolutionPath
  -estimatedDamageAmount : BigDecimal
  -tenantAgreesToPay : Boolean
  -repairAppointmentAt : LocalDateTime
}

class MaintenanceRequestResponse <<dto>> {
  -id : Long
  -status : MaintenanceStatus
  -damageCause : DamageCause
  -issuedInvoice : TenantInvoice
}

class MaintenanceRequest <<entity>> {
  -id : Long {id}
  -status : MaintenanceStatus
  -damageCause : DamageCause
  -faultReason : String
  -faultResolutionPath : FaultResolutionPath
  -estimatedDamageAmount : BigDecimal
  -repairAppointmentAt : LocalDateTime
}

class MaintenanceTimeline <<entity>> {
  -id : Long {id}
  -oldStatus : MaintenanceStatus
  -newStatus : MaintenanceStatus
  -note : String
}

enum MaintenanceStatus <<enumeration>> {
  OPEN
  REPAIR_SCHEDULED
  IN_REPAIR
  TENANT_FAULT
  PENDING_TENANT_REPAIR
}

enum DamageCause <<enumeration>> {
  WEAR
  TENANT_MISUSE
  TENANT_MODIFICATION
}

MaintenanceController --> MaintenanceService : maintenanceService
MaintenanceController ..> MaintenanceDiagnoseRequest : <<use>>
MaintenanceServiceImpl ..|> MaintenanceService
MaintenanceServiceImpl --> MaintenanceRequestRepository : repository
MaintenanceServiceImpl --> MaintenanceTimelineRepository : maintenanceTimelineRepository
MaintenanceRequestRepository ..> MaintenanceRequest : <<use>>
MaintenanceTimelineRepository ..> MaintenanceTimeline : <<use>>
MaintenanceRequest ..> MaintenanceStatus
MaintenanceRequest ..> DamageCause

note right of MaintenanceServiceImpl
  WEAR → IN_REPAIR / REPAIR_SCHEDULED
  TENANT_MISUSE → TENANT_FAULT
  (+ tenantAgreesToPay)
  Invoice NOT issued at diagnose
  (issued at complete/handover)
end note

@enduml
