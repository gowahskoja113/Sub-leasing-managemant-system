@startuml ClassDiagram_F5d_Settlement
title Figure F5d — Settlement (Submit + Accept) Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class CheckoutProcessController <<controller>> {
  -checkoutProcessService : CheckoutProcessService
  +submitSettlement(id: Long) : void
}

class TenantCheckoutProcessController <<controller>> {
  -checkoutProcessService : CheckoutProcessService
  +acceptSettlement(id: Long) : void
  +disputeSettlement(id: Long, request: CheckoutDisputeRequest) : void
}

interface CheckoutProcessService {
  +submitSettlement(checkoutRequestId: Long) : void
  +acceptSettlement(requestId: Long, tenantId: UUID) : void
  +disputeSettlement(requestId: Long, tenantId: UUID, request: CheckoutDisputeRequest) : void
}

class CheckoutProcessServiceImpl <<service>> {
  -checkoutRequestRepository : CheckoutRequestRepository
  -checkoutSettlementRepository : CheckoutSettlementRepository
  +submitSettlement(checkoutRequestId: Long) : void
  +acceptSettlement(requestId: Long, tenantId: UUID) : void
  +disputeSettlement(requestId: Long, tenantId: UUID, request: CheckoutDisputeRequest) : void
}

interface CheckoutRequestRepository {
  +findById(id: Long) : Optional<CheckoutRequest>
  +save(r: CheckoutRequest) : CheckoutRequest
}

interface CheckoutSettlementRepository {
  +save(s: CheckoutSettlement) : CheckoutSettlement
}

class CheckoutDisputeRequest <<dto>> {
  -reason : String
}

class CheckoutRequest <<entity>> {
  -id : Long {id}
  -status : CheckoutRequestStatus
  -disputeCount : Integer
  -disputeReason : String
  -disputedAt : LocalDateTime
}

class CheckoutSettlement <<entity>> {
  -id : Long {id}
  -depositAmount : BigDecimal
  -unpaidTotal : BigDecimal
  -damageTotal : BigDecimal
  -adjustmentTotal : BigDecimal
  -refundAmount : BigDecimal
  -extraChargeAmount : BigDecimal
  -createdAt : LocalDateTime
}

enum CheckoutRequestStatus <<enumeration>> {
  INSPECTING
  WAITING_TENANT
  DISPUTED
  SETTLING
}

CheckoutProcessController --> CheckoutProcessService : checkoutProcessService
TenantCheckoutProcessController --> CheckoutProcessService : checkoutProcessService
TenantCheckoutProcessController ..> CheckoutDisputeRequest : <<use>>
CheckoutProcessServiceImpl ..|> CheckoutProcessService
CheckoutProcessServiceImpl --> CheckoutRequestRepository : checkoutRequestRepository
CheckoutProcessServiceImpl --> CheckoutSettlementRepository : checkoutSettlementRepository
CheckoutRequestRepository ..> CheckoutRequest : <<use>>
CheckoutSettlementRepository ..> CheckoutSettlement : <<use>>
CheckoutRequest "1" *-- "1" CheckoutSettlement
CheckoutRequest ..> CheckoutRequestStatus

note right of CheckoutProcessServiceImpl
  submitSettlement:
  deposit - unpaid - damage
  → status = WAITING_TENANT

  acceptSettlement:
  → status = SETTLING
end note

@enduml
