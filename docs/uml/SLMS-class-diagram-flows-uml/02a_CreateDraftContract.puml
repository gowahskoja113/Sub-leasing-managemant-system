@startuml ClassDiagram_F2a_CreateDraftContract
title Figure F2a — Manager Create Draft Contract Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class TenantContractController <<controller>> {
  -tenantOnboardingService : TenantOnboardingService
  +onboardRoomTenant(roomId: Long, request: OnboardTenantRequest) : TenantContractResponse
}

interface TenantOnboardingService {
  +onboardTenant(roomId: Long, request: OnboardTenantRequest) : TenantContractResponse
}

class TenantOnboardingServiceImpl <<service>> {
  -tenantContractRepository : TenantContractRepository
  -roomRepository : RoomRepository
  +onboardTenant(roomId: Long, request: OnboardTenantRequest) : TenantContractResponse
}

interface TenantContractRepository {
  +save(c: TenantContract) : TenantContract
}

interface RoomRepository {
  +findById(id: Long) : Optional<Room>
}

class OnboardTenantRequest <<dto>> {
  -draftTenantName : String
  -draftTenantPhone : String
  -rentAmount : BigDecimal
  -deposit : BigDecimal
  -initialElectricReading : BigDecimal
  -initialWaterReading : BigDecimal
  -roomConditionNote : String
}

class TenantContractResponse <<dto>> {
  -id : Long
  -status : ContractStatus
  -rentAmount : BigDecimal
  -deposit : BigDecimal
}

class TenantContract <<entity>> {
  -id : Long {id}
  -contractCode : String {unique}
  -rentAmount : BigDecimal
  -deposit : BigDecimal
  -initialElectricReading : BigDecimal
  -initialWaterReading : BigDecimal
  -electricMeterImageUrl : String
  -waterMeterImageUrl : String
  -roomConditionNote : String
  -draftTenantName : String
  -draftTenantPhone : String
  -status : ContractStatus
  -priceApprovalStatus : PriceApprovalStatus
}

class Room <<entity>> {
  -id : Long {id}
  -status : RoomStatus
}

enum ContractStatus <<enumeration>> {
  DRAFT
}

enum PriceApprovalStatus <<enumeration>> {
  PENDING_PRICE_APPROVAL
  APPROVED_AWAITING_DEPOSIT
}

enum RoomStatus <<enumeration>> {
  AVAILABLE
  RENTED
}

TenantContractController --> TenantOnboardingService : tenantOnboardingService
TenantContractController ..> OnboardTenantRequest : <<use>>
TenantContractController ..> TenantContractResponse : <<use>>
TenantOnboardingServiceImpl ..|> TenantOnboardingService
TenantOnboardingServiceImpl --> TenantContractRepository : tenantContractRepository
TenantOnboardingServiceImpl --> RoomRepository : roomRepository
TenantContractRepository ..> TenantContract : <<use>>
RoomRepository ..> Room : <<use>>
TenantContract ..> ContractStatus
TenantContract ..> PriceApprovalStatus
Room ..> RoomStatus

note right of TenantOnboardingServiceImpl
  «@Transactional»
  validate occupancy
  (1 ACTIVE contract / room)
  → save TenantContract DRAFT
  + evidence photos + meters
end note

@enduml
