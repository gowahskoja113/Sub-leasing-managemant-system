@startuml ClassDiagram_F3b_PublishUtilityBill
title Figure F3b — Admin Publish EVN/Water Bill Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class AdminUtilityBillController <<controller>> {
  -utilityBillService : UtilityBillService
  +create(request: CreateUtilityBillRequest) : UtilityBillResponse
}

interface UtilityBillService {
  +createUtilityBill(request: CreateUtilityBillRequest) : UtilityBillResponse
  +revokeBill(id: Long) : void
}

class UtilityBillServiceImpl <<service>> {
  -utilityBillRepository : UtilityBillRepository
  -utilityInvoiceService : UtilityInvoiceService
  +createUtilityBill(request: CreateUtilityBillRequest) : UtilityBillResponse
  +revokeBill(id: Long) : void
}

interface UtilityInvoiceService {
  +issueElectricFromSavedReadings(bill: UtilityBill) : List<UtilityInvoiceResponse>
  +issueWaterFromSavedReadings(bill: UtilityBill) : List<UtilityInvoiceResponse>
}

interface UtilityBillRepository {
  +save(b: UtilityBill) : UtilityBill
}

class CreateUtilityBillRequest <<dto>> {
  -type : UtilityType
  -billingPeriod : String
  -totalQuantity : Integer
  -totalAmount : BigDecimal
  -unitPrice : BigDecimal
  -imageUrl : String
  -readingDeadline : LocalDate
}

class UtilityBillResponse <<dto>> {
  -id : Long
  -type : UtilityType
  -billingPeriod : String
  -status : UtilityBillStatus
  -totalAmount : BigDecimal
}

class UtilityBill <<entity>> {
  -id : Long {id}
  -type : UtilityType
  -billingPeriod : String
  -month : Integer
  -year : Integer
  -totalQuantity : Integer
  -totalAmount : BigDecimal
  -unitPrice : BigDecimal
  -imageUrl : String
  -status : UtilityBillStatus
  -createdBy : UUID
  -createdAt : LocalDateTime
  -readingDeadline : LocalDate
  -billedToTenantQuantity : BigDecimal
  -companyBornQuantity : BigDecimal
}

class UtilityInvoice <<entity>> {
  -id : Long {id}
  -utilityType : UtilityType
  -billingPeriod : String
  -prevReading : BigDecimal
  -newReading : BigDecimal
  -consumption : BigDecimal
  -unitPrice : BigDecimal
  -amount : BigDecimal
  -status : UtilityInvoiceStatus
  -sentAt : LocalDateTime
}

class TenantInvoice <<entity>> {
  -id : Long {id}
  -utilityInvoiceId : Long
  -status : TenantInvoiceStatus
  -grandTotal : BigDecimal
}

enum UtilityType <<enumeration>> {
  ELECTRIC
  WATER
}

enum UtilityBillStatus <<enumeration>> {
  PUBLISHED
  REVOKED
}

enum UtilityInvoiceStatus <<enumeration>> {
  SENT
}

enum TenantInvoiceStatus <<enumeration>> {
  PENDING
}

AdminUtilityBillController --> UtilityBillService : utilityBillService
AdminUtilityBillController ..> CreateUtilityBillRequest : <<use>>
AdminUtilityBillController ..> UtilityBillResponse : <<use>>
UtilityBillServiceImpl ..|> UtilityBillService
UtilityBillServiceImpl --> UtilityBillRepository : utilityBillRepository
UtilityBillServiceImpl --> UtilityInvoiceService : utilityInvoiceService
UtilityBillRepository ..> UtilityBill : <<use>>
UtilityBill ..> UtilityBillStatus
UtilityBill ..> UtilityType
UtilityInvoice ..> UtilityInvoiceStatus
UtilityBill "1" ..> "*" UtilityInvoice : <<issue from locked readings>>
UtilityInvoice "1" o-- "0..1" TenantInvoice

note right of UtilityBillServiceImpl
  «@Transactional»
  save UtilityBill PUBLISHED
  → issueElectric/WaterFromSavedReadings
  (INSERT invoices from locked readings)
end note

@enduml
