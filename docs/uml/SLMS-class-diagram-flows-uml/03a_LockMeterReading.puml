@startuml ClassDiagram_F3a_LockMeterReading
title Figure F3a — Manager Lock Meter Reading Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class MeterReadingController <<controller>> {
  -meterReadingService : MeterReadingService
  +saveLocked(request: SaveLockedReadingRequest) : SavedMeterReadingItem
}

interface MeterReadingService {
  +saveLockedReading(request: SaveLockedReadingRequest) : SavedMeterReadingItem
}

class MeterReadingServiceImpl <<service>> {
  -meterReadingRepository : MeterReadingRepository
  -utilityInvoiceService : UtilityInvoiceService
  +saveLockedReading(request: SaveLockedReadingRequest) : SavedMeterReadingItem
}

interface UtilityInvoiceService {
  +issueElectricFromSavedReading(reading: MeterReading) : UtilityInvoiceResponse
  +issueWaterFromSavedReading(reading: MeterReading) : UtilityInvoiceResponse
}

interface MeterReadingRepository {
  +save(r: MeterReading) : MeterReading
}

class SaveLockedReadingRequest <<dto>> {
  -propertyId : Long
  -roomId : Long
  -utilityType : UtilityType
  -period : String
  -reading : BigDecimal
  -imageUrl : String
  -overrideReason : String
}

class SavedMeterReadingItem <<dto>> {
  -id : Long
  -utilityType : UtilityType
  -period : String
  -reading : BigDecimal
  -utilityInvoiceId : Long
}

class MeterReading <<entity>> {
  -id : Long {id}
  -utilityType : UtilityType
  -period : String
  -reading : BigDecimal
  -prevReading : BigDecimal
  -imageUrl : String
  -recordedAt : LocalDateTime
  -recordedBy : UUID
  -utilityInvoiceId : Long
}

class UtilityInvoice <<entity>> {
  -id : Long {id}
  -utilityType : UtilityType
  -billingPeriod : String
  -amount : BigDecimal
  -status : UtilityInvoiceStatus
}

class TenantInvoice <<entity>> {
  -id : Long {id}
  -utilityInvoiceId : Long
  -status : TenantInvoiceStatus
  -grandTotal : BigDecimal
}

enum UtilityType <<enumeration>> {
  ELECTRIC
  WATER
}

enum UtilityInvoiceStatus <<enumeration>> {
  SENT
}

enum TenantInvoiceStatus <<enumeration>> {
  PENDING
}

MeterReadingController --> MeterReadingService : meterReadingService
MeterReadingController ..> SaveLockedReadingRequest : <<use>>
MeterReadingServiceImpl ..|> MeterReadingService
MeterReadingServiceImpl --> MeterReadingRepository : meterReadingRepository
MeterReadingServiceImpl --> UtilityInvoiceService : utilityInvoiceService
MeterReadingRepository ..> MeterReading : <<use>>
MeterReading ..> UtilityType
MeterReading ..> UtilityInvoice : <<use>>\n(utilityInvoiceId)
UtilityInvoice "1" o-- "0..1" TenantInvoice

note right of MeterReadingServiceImpl
  «@Transactional»
  validate period, reading, contract ACTIVE
  → save MeterReading
  opt [UtilityBill already PUBLISHED]
  → issue*FromSavedReading
  (UtilityInvoice + TenantInvoice PENDING)
end note

@enduml
