@startuml ClassDiagram_F4b_ViewTicket
title Figure F4b — Manager View Ticket Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class MaintenanceController <<controller>> {
  -maintenanceService : MaintenanceService
  +getRequestById(id: Long) : MaintenanceRequestResponse
}

interface MaintenanceService {
  +getRequestById(id: Long) : MaintenanceRequestResponse
}

class MaintenanceServiceImpl <<service>> {
  -repository : MaintenanceRequestRepository
  -equipmentService : EquipmentService
  +getRequestById(id: Long) : MaintenanceRequestResponse
}

interface EquipmentService {
  +getSnapshot(equipmentId: Long) : EquipmentSnapshot
}

class EquipmentServiceImpl <<service>> {
  -equipmentRepository : EquipmentRepository
  +getSnapshot(equipmentId: Long) : EquipmentSnapshot
}

interface MaintenanceRequestRepository {
  +findById(id: Long) : Optional<MaintenanceRequest>
}

interface EquipmentRepository {
  +findById(id: Long) : Optional<Equipment>
}

class MaintenanceRequestResponse <<dto>> {
  -id : Long
  -requestCode : String
  -status : MaintenanceStatus
  -qrScanRequiredToProcess : boolean
  -equipment : EquipmentSnapshot
}

class EquipmentSnapshot <<dto>> {
  -equipmentId : Long
  -maintenanceCount : int
  -remainingDepreciation : BigDecimal
  -warrantyMonths : Integer
  -remainingWarranty : Integer
}

class MaintenanceRequest <<entity>> {
  -id : Long {id}
  -requestCode : String
  -status : MaintenanceStatus
  -equipmentId : Long
  -title : String
  -description : String
}

class Equipment <<entity>> {
  -id : Long {id}
  -equipmentName : String
  -qrCode : String {unique}
  -maintenanceCount : int
  -warrantyMonths : Integer
  -warrantyEndDate : LocalDate
  -status : EquipmentStatus
}

enum MaintenanceStatus <<enumeration>> {
  OPEN
  REPAIR_SCHEDULED
  IN_REPAIR
  TENANT_FAULT
}

enum EquipmentStatus <<enumeration>> {
  GOOD
  DAMAGED
  MAINTENANCE
  BROKEN
}

MaintenanceController --> MaintenanceService : maintenanceService
MaintenanceServiceImpl ..|> MaintenanceService
EquipmentServiceImpl ..|> EquipmentService
MaintenanceServiceImpl --> MaintenanceRequestRepository : repository
MaintenanceServiceImpl --> EquipmentService : equipmentService
EquipmentServiceImpl --> EquipmentRepository : equipmentRepository
MaintenanceRequestRepository ..> MaintenanceRequest : <<use>>
EquipmentRepository ..> Equipment : <<use>>
MaintenanceRequest "0..*" --> "1" Equipment : equipmentId
MaintenanceRequest ..> MaintenanceStatus
Equipment ..> EquipmentStatus

note right of MaintenanceServiceImpl
  GET ticket + equipment snapshot
  (maintenanceCount, warranty,
  remainingDepreciation)
  → qrScanRequiredToProcess=true
end note

@enduml
