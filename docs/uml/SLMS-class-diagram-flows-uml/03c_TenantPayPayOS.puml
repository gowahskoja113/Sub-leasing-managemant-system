@startuml ClassDiagram_F3c_TenantPayPayOS
title Figure F3c — Tenant Pay via PayOS Class Diagram
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FAFF
  BorderColor #3B5B92
  ArrowColor #3B5B92
}
skinparam interface {
  BackgroundColor #FBF3E8
  BorderColor #B07A2A
}
hide circle
hide empty members

class TenantMeController <<controller>> {
  -tenantBillingService : TenantBillingService
  +createPayment(invoiceId: Long) : PaymentLinkResponse
}

class PayosWebhookController <<controller>> {
  -payosService : PayosService
  -tenantBillingService : TenantBillingService
  +handleWebhook(payload: PayosWebhookPayload) : ResponseEntity<Map>
}

interface TenantBillingService {
  +createPayosOrder(invoice: TenantInvoice) : TenantInvoicePayosOrder
  +createPayment(invoiceId: Long) : PaymentLinkResponse
  +markInvoicePaid(orderCode: long) : void
}

class TenantBillingServiceImpl <<service>> {
  -tenantInvoiceRepository : TenantInvoiceRepository
  -payosOrderRepository : TenantInvoicePayosOrderRepository
  -payosService : PayosService
  +createPayosOrder(invoice: TenantInvoice) : TenantInvoicePayosOrder
  +createPayment(invoiceId: Long) : PaymentLinkResponse
  +markInvoicePaid(orderCode: long) : void
}

interface PayosService {
  +createPaymentLink(orderCode: long, amount: long, description: String) : PaymentLink
}

class PayosServiceImpl <<service>> {
  +createPaymentLink(orderCode: long, amount: long, description: String) : PaymentLink
}

interface TenantInvoiceRepository {
  +findById(id: Long) : Optional<TenantInvoice>
  +save(i: TenantInvoice) : TenantInvoice
}

interface TenantInvoicePayosOrderRepository {
  +save(o: TenantInvoicePayosOrder) : TenantInvoicePayosOrder
}

class PaymentLinkResponse <<dto>> {
  -orderCode : Long
  -checkoutUrl : String
  -qrCode : String
  -amount : BigDecimal
}

class TenantInvoice <<entity>> {
  -id : Long {id}
  -code : String {unique}
  -tenantUserId : UUID
  -invoiceType : TenantInvoiceType
  -totalAmount : BigDecimal
  -lateFee : BigDecimal
  -grandTotal : BigDecimal
  -status : TenantInvoiceStatus
  -dueDate : LocalDate
  -paidAt : LocalDateTime
  -paymentMethod : String
  -payosOrderCode : Long
  -payosCheckoutUrl : String
  -payosQrCode : String
}

class TenantInvoicePayosOrder <<entity>> {
  -id : Long {id}
  -orderCode : Long
  -amount : BigDecimal
  -checkoutUrl : String
  -status : String
}

class TenantPayment <<entity>> {
  -id : Long {id}
  -amount : BigDecimal
  -method : String
  -paidAt : LocalDateTime
}

enum TenantInvoiceStatus <<enumeration>> {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELLED
}

TenantMeController --> TenantBillingService : tenantBillingService
PayosWebhookController --> PayosService : payosService
PayosWebhookController --> TenantBillingService : tenantBillingService
TenantBillingServiceImpl ..|> TenantBillingService
PayosServiceImpl ..|> PayosService
TenantBillingServiceImpl --> TenantInvoiceRepository : tenantInvoiceRepository
TenantBillingServiceImpl --> TenantInvoicePayosOrderRepository : payosOrderRepository
TenantBillingServiceImpl --> PayosService : payosService
TenantInvoiceRepository ..> TenantInvoice : <<use>>
TenantInvoicePayosOrderRepository ..> TenantInvoicePayosOrder : <<use>>
TenantInvoice "1" o-- "0..*" TenantInvoicePayosOrder
TenantInvoice "1" o-- "0..*" TenantPayment
TenantInvoice ..> TenantInvoiceStatus

note right of TenantBillingServiceImpl
  createPayment → PayOS QR
  webhook → markInvoicePaid
  (TenantInvoice PAID + TenantPayment)

  Cron BillingCronServiceImpl.runDailySweep
  (08:00): issue rent + overdue reminders
end note

@enduml
